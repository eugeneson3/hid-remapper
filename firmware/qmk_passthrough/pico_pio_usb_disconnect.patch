+
   if (t > 0) {
+    uint32_t rx_start = time_us_32();
     while ((pp->pio_usb_rx->irq & IRQ_RX_COMP_MASK) == 0) {
+      if ((uint32_t)(time_us_32() - rx_start) > 1200) {
+        pio_usb_bus_reboot_on_fault();
+      }
       continue;
     }
   }
@@ -180,6 +210,7 @@ int __no_inline_not_in_flash_func(pio_usb_bus_receive_packet_and_handshake)(
   uint16_t idx = 0;
   uint16_t nak_timeout = 10000;
   const uint16_t rx_buf_len = sizeof(pp->usb_rx_buffer) / sizeof(pp->usb_rx_buffer[0]);
+  uint32_t rx_start = time_us_32();
 
   while (t--) {
     if (pio_sm_get_rx_fifo_level(pp->pio_usb_rx, pp->sm_rx)) {
@@ -191,10 +222,18 @@ int __no_inline_not_in_flash_func(pio_usb_bus_receive_packet_and_handshake)(
     }
   }
 
+  if (idx != 2) {
+    pio_usb_bus_reboot_on_fault();
+  }
+
   // timing critical start
   if (t > 0) {
     if (handshake == USB_PID_ACK) {
-      while ((pp->pio_usb_rx->irq & IRQ_RX_COMP_MASK) == 0 && idx < rx_buf_len - 1) {
+      while ((pp->pio_usb_rx->irq & IRQ_RX_COMP_MASK) == 0 &&
+             idx < rx_buf_len - 1) {
+        if ((uint32_t)(time_us_32() - rx_start) > 1200) {
+          pio_usb_bus_reboot_on_fault();
+        }
         if (pio_sm_get_rx_fifo_level(pp->pio_usb_rx, pp->sm_rx)) {
           uint8_t data = pio_sm_get(pp->pio_usb_rx, pp->sm_rx) >> 24;
           crc_prev2 = crc_prev;
@@ -215,6 +254,9 @@ int __no_inline_not_in_flash_func(pio_usb_bus_receive_packet_and_handshake)(
     } else {
       // just discard received data since we NAK/STALL anyway
       while ((pp->pio_usb_rx->irq & IRQ_RX_COMP_MASK) == 0 && nak_timeout--) {
+        if ((uint32_t)(time_us_32() - rx_start) > 1200) {
+          pio_usb_bus_reboot_on_fault();
+        }
         continue;
       }
       pio_sm_clear_fifos(pp->pio_usb_rx, pp->sm_rx);
