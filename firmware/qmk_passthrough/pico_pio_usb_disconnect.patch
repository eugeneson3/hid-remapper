diff --git a/src/pio_usb.c b/src/pio_usb.c
--- a/src/pio_usb.c
+++ b/src/pio_usb.c
@@ -14,6 +14,7 @@
 #include "hardware/pio.h"
 #include "hardware/pio_instructions.h"
 #include "hardware/sync.h"
+#include "hardware/watchdog.h"
 #include "pico/bootrom.h"
