 #include "pico/platform.h"
@@ -38,6 +39,15 @@ static uint8_t nak_encoded[5];
 static uint8_t stall_encoded[5];
 static uint8_t pre_encoded[5];
 
+// Cable removal can leave the PIO receiver in a state where TinyUSB never
+// sees an unmount. A full watchdog reset is the same recovery path as RESET.
+static void __no_inline_not_in_flash_func(pio_usb_bus_reboot_on_fault)(void) {
+  watchdog_reboot(0, 0, 0);
+  while (true) {
+    tight_loop_contents();
+  }
+}
+
 //--------------------------------------------------------------------+
 // Bus functions
 //--------------------------------------------------------------------+
@@ -53,8 +63,12 @@ static void __no_inline_not_in_flash_func(send_pre)(const pio_port_t *pp) {
   dma_channel_transfer_from_buffer_now(pp->tx_ch, pre_encoded,
                                        sizeof(pre_encoded));
   pp->pio_usb_tx->irq = IRQ_TX_ALL_MASK;       // clear complete flag
+  uint32_t tx_start = time_us_32();
 
   while ((pp->pio_usb_tx->irq & IRQ_TX_EOP_MASK) == 0) {
+    if ((uint32_t)(time_us_32() - tx_start) > 2000) {
+      pio_usb_bus_reboot_on_fault();
+    }
     continue;
   }
   pio_sm_clear_fifos(pp->pio_usb_tx, pp->sm_tx);
@@ -86,11 +100,19 @@ void __not_in_flash_func(pio_usb_bus_usb_transfer)(const pio_port_t *pp,
   pp->pio_usb_tx->irq = IRQ_TX_ALL_MASK; // clear complete flag
 
   io_ro_32 *pc = &pp->pio_usb_tx->sm[pp->sm_tx].addr;
+  uint32_t tx_start = time_us_32();
   while ((pp->pio_usb_tx->irq & IRQ_TX_ALL_MASK) == 0) {
+    if ((uint32_t)(time_us_32() - tx_start) > 2000) {
+      pio_usb_bus_reboot_on_fault();
+    }
     continue;
   }
   pio_sm_clear_fifos(pp->pio_usb_tx, pp->sm_tx);
+  tx_start = time_us_32();
   while (*pc < PIO_USB_TX_ENCODED_DATA_COMP) {
+    if ((uint32_t)(time_us_32() - tx_start) > 2000) {
+      pio_usb_bus_reboot_on_fault();
+    }
     continue;
   }
 }
@@ -157,8 +179,16 @@ uint8_t __no_inline_not_in_flash_func(pio_usb_bus_wait_handshake)(pio_port_t* pp
     }
   }
 
+  if (idx != 2 || (pp->pio_usb_rx->irq & IRQ_RX_COMP_MASK) == 0) {
+    pio_usb_bus_reboot_on_fault();
