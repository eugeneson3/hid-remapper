-
-    return matrix_has_changed;
-}
+bool matrix_scan_custom(matrix_row_t current_matrix[]) {
+    static matrix_row_t physical_matrix[MATRIX_ROWS];
+    static uint32_t last_c1_heartbeat;
+    static uint32_t last_c1_progress_ms;
+    static bool c1_watch_started;
+    bool matrix_has_changed = false;
+    uint32_t heartbeat = c1_heartbeat;
+
+    if (!c1_ready || !c1_watch_started || heartbeat != last_c1_heartbeat) {
+        last_c1_heartbeat = heartbeat;
+        last_c1_progress_ms = timer_read32();
+        c1_watch_started = c1_ready;
+    } else if (timer_elapsed32(last_c1_progress_ms) > 2000) {
+        // The USB Host core can freeze before TinyUSB emits an unmount callback.
+        // A full reset is the only proven way to reinitialize PIO and TinyUSB.
+        watchdog_reboot(0, 0, 0);
+    }
+
+    if (hid_disconnect_flag) {
+        memset(physical_matrix, 0, sizeof(physical_matrix));
+        hid_report_size = 0;
+        hid_disconnect_flag = false;
+    }
+
+    if (hid_report_size > 0) {
+        matrix_dest = physical_matrix;
+        parse_report(hid_instance, hid_report_buffer, hid_report_size);
+        hid_report_size = 0;
+    }
+
+    jarvis_injection_update();
+    for (uint8_t rowIdx = 0; rowIdx < MATRIX_ROWS; rowIdx++) {
+        matrix_row_t merged = physical_matrix[rowIdx] |
+                              jarvis_injection_row(rowIdx);
+        if (current_matrix[rowIdx] != merged) {
+            matrix_has_changed = true;
+            current_matrix[rowIdx] = merged;
+        }
+    }
+
+    return matrix_has_changed;
+}
