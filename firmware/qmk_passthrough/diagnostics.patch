-    } else {
-        return false;
-    }
-
-    return matrix_has_changed;
-}
+bool matrix_scan_custom(matrix_row_t current_matrix[]) {
+    static matrix_row_t physical_matrix[MATRIX_ROWS];
+    static uint32_t observed_generation;
+    static bool wait_for_all_keys_released;
+    bool matrix_has_changed = false;
+
+    uint32_t generation = __atomic_load_n(&hid_connection_generation, __ATOMIC_ACQUIRE);
+    bool connected = __atomic_load_n(&hid_connected, __ATOMIC_ACQUIRE);
+    if (generation != observed_generation) {
+        memset(physical_matrix, 0, sizeof(physical_matrix));
+        __atomic_store_n(&hid_report_size, 0, __ATOMIC_RELEASE);
+        observed_generation = generation;
+        wait_for_all_keys_released = connected;
+    }
+
+    uint8_t report_size = __atomic_load_n(&hid_report_size, __ATOMIC_ACQUIRE);
+    if (connected && report_size > 0) {
+        uint8_t report_buffer[sizeof(hid_report_buffer)];
+        uint8_t report_instance = hid_instance;
+        uint32_t report_generation = hid_report_generation;
+        memcpy(report_buffer, hid_report_buffer, report_size);
+
+        if (report_generation == observed_generation) {
+            keyboard_report_received = false;
+            parsed_hid_instance = report_instance;
+            matrix_dest = physical_matrix;
+            parse_report(report_instance, report_buffer, report_size);
+
+            if (keyboard_report_received && wait_for_all_keys_released) {
+                bool any_key_pressed = false;
+                for (uint8_t rowIdx = 0; rowIdx < MATRIX_ROWS - 1; rowIdx++) {
+                    any_key_pressed |= physical_matrix[rowIdx] != 0;
+                }
+                memset(physical_matrix, 0, sizeof(physical_matrix));
+                if (!any_key_pressed) {
+                    wait_for_all_keys_released = false;
+                }
+            }
+        }
+        __atomic_store_n(&hid_report_size, 0, __ATOMIC_RELEASE);
+    }
+
+    generation = __atomic_load_n(&hid_connection_generation, __ATOMIC_ACQUIRE);
+    connected = __atomic_load_n(&hid_connected, __ATOMIC_ACQUIRE);
+    if (generation != observed_generation || !connected) {
+        memset(physical_matrix, 0, sizeof(physical_matrix));
+        __atomic_store_n(&hid_report_size, 0, __ATOMIC_RELEASE);
+        observed_generation = generation;
+        wait_for_all_keys_released = connected;
+    }
+
+    jarvis_injection_update();
+    for (uint8_t rowIdx = 0; rowIdx < MATRIX_ROWS; rowIdx++) {
+        matrix_row_t merged = physical_matrix[rowIdx] |
+                              jarvis_injection_row(rowIdx);
+        if (current_matrix[rowIdx] != merged) {
+            matrix_has_changed = true;
+            current_matrix[rowIdx] = merged;
+        }
+    }
+
+    return matrix_has_changed;
+}
